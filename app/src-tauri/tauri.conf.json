{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fancypants",
  "version": "0.3.0",
  "identifier": "io.github.goopi34.fancypants",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fancypants",
        "width": 520,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
